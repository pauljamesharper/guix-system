#!/usr/bin/env bash
set -e

packages=(
  bash
  coreutils
  glibc
  gcc-toolchain
  jemalloc
  mono

  # Utilities
  findutils
  grep
  sed
  gawk
  file
  which
  util-linux
  procps
  xz
  lz4
  zstd
  tar
  gzip
  unrar
  unzip
  7zip
  yad
  zenity
  cage

  gtk
  gtk+
  hicolor-icon-theme
  adwaita-icon-theme

  # Graphics
  mesa
  mesa-utils
  vulkan-tools

  # Audio
  pipewire
  pulseaudio
  alsa-lib
  alsa-plugins
)

guix shell \
  --container \
  --network \
  --emulate-fhs \
  --share="$HOME" \
  --share=/tmp/.X11-unix \
  --share="$XDG_RUNTIME_DIR" \
  --expose=/dev/dri \
  --expose=/dev/snd \
  --expose=/sys \
  --preserve='^HOME$' \
  --preserve='^WAYLAND_DISPLAY$' \
  --preserve='^XDG_RUNTIME_DIR$' \
  --preserve='^DISPLAY$' \
  --preserve='^XDG_SESSION_TYPE$' \
  --preserve='^DBUS_SESSION_BUS_ADDRESS$' \
  --preserve='^PULSE_SERVER$' \
  --preserve='^PIPEWIRE_REMOTE$' \
  --preserve='^XAUTHORITY$' \
  "${packages[@]}" \
  -- "$@"
